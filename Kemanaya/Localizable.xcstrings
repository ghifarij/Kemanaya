    },
    "Anggaran" : {
      "comment" : "VoiceOver label of the budget block in the subcategory detail.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget"
          }
        }
      }
    },
    "Anggaran %@" : {
      "comment" : "Title of a budget sheet: a group's from Pengaturan, e.g. 'Anggaran Kebutuhan', or one subcategory's from its editor, e.g. 'Anggaran Kopi'. The placeholder is the group or subcategory name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ budget"
          }
        }
      }
    },
    "Anggaran %@ per bulan" : {
      "comment" : "Subcategory detail: the subcategory's standing monthly budget, e.g. 'Anggaran Rp300.000 per bulan'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ monthly budget"
          }
        }
      }
    },
    "anggaran %lld rupiah, lewat %lld rupiah" : {
      "comment" : "VoiceOver: a budget and how far spending went over it, in whole rupiah. 1: the budget, 2: the amount over. Neutral, never blame.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "budget %1$lld rupiah, over by %2$lld rupiah"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "anggaran %1$lld rupiah, lewat %2$lld rupiah"
          }
        }
      }
    },
    "anggaran %lld rupiah, sisa %lld rupiah" : {
      "comment" : "VoiceOver: a budget and what is left of it, in whole rupiah. 1: the budget, 2: the amount left.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "budget %1$lld rupiah, %2$lld rupiah left"

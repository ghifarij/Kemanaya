      }
    },
    "Baris bawah: sisa anggaran, atau bulan lalu kalau tanpa anggaran." : {
      "comment" : "Onboarding page 2: a card's bottom line shows the budget left ('sisa'), or last month's total when the card has no budget (D-068).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bottom line: budget left, or last month if there's no budget."
          }
        }
      }
    },
    "Batal" : {
      "comment" : "Cancels: closes a sheet or dialog without saving, deleting or restoring (the add sheet, the delete dialogs, the restore alert, the budget sheet and the subcategory editor).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "Belum ada cadangan yang bisa disimpan dari sini." : {

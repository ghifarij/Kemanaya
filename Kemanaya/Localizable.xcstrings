      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget"
          }
        }
      }
    },
    "Anggaran %@" : {
      "comment" : "Title of a budget keypad sheet, and a group row on the Anggaran sheet: a group's, e.g. 'Anggaran Kebutuhan', or one subcategory's, e.g. 'Anggaran Kopi' (D-077). The placeholder is the group or subcategory name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ budget"
          }
        }
      }
    },
    "Anggaran %@ per bulan" : {
      "comment" : "Subcategory detail: the subcategory's standing monthly budget, e.g. 'Anggaran Rp300.000 per bulan'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ monthly budget"
          }
        }
      }
    },
    "Anggaran belum tersimpan" : {
      "comment" : "Alert title when saving a budget failed and trying again may work.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budget not saved"
          }
        }
      }
    },
    "Anggaran itu pilihan. Pasang lewat Anggaran di Beranda atau menu kartu." : {
      "comment" : "Onboarding page 3: budgets are optional; set them from Anggaran (the small link on Home's hero, which opens the Anggaran sheet) or a card's long-press menu (D-077).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgets are optional. Set them from Budgets on Home or a card's menu."
          }
        }
      }
    },
    "Anggaran subkategori adalah bagian dari anggaran kelompoknya, bukan tambahan." : {
      "comment" : "Anggaran sheet: footer under the last group. A subcategory budget is a slice of its group's budget, not extra money (D-077).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A subcategory budget is part of its group's budget, not extra."
          }
        }
      }
    },
    "Atur" : {
      "comment" : "Button above Home's pinned cards that opens pin management (pin, unpin, reorder).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage"

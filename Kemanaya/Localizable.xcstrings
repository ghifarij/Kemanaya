    "Anggaran bulanan" : {
      "comment" : "Subcategory editor: the row that opens the subcategory's optional monthly budget.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly budget"
          }
        }
      }
    },
    "Anggaran bulanan tiap kelompok, tampil di Beranda. Anggaran per subkategori diatur di Kelola subkategori." : {
      "comment" : "Pengaturan: footer of the budgets section. Group budgets show on Home; subcategory budgets are set in Kelola subkategori (D-041).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A monthly budget for each group, shown on Home. Subcategory budgets are set in Manage subcategories."
          }
        }
      }
    },
    "Anggaran itu pilihan. Atur di Pengaturan kalau kamu mau, per kelompok atau per kategori." : {
      "comment" : "Onboarding page 3: budgets are optional and set in Pengaturan, per group or per subcategory.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgets are optional. Set them in Settings if you like, per group or per category."
          }
        }
      }
    },
    "Atur" : {
      "comment" : "Button above Home's pinned cards that opens pin management (pin, unpin, reorder).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage"
          }
        }
      }
    },
    "Atur kartu" : {

{
  "sourceLanguage" : "id",
  "strings" : {
    "%@ sebesar %@ akan dihapus permanen." : {
      "comment" : "Message of the delete dialog. 1: subcategory name, e.g. Makan. 2: the amount, e.g. Rp30.000.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ sebesar %2$@ akan dihapus permanen."
          }
        }
      }
    },
    "%lld rupiah" : {
      "comment" : "VoiceOver reading of a money amount. The number is whole rupiah, without separators."
    },
    "%lld rupiah bulan ini, naik dibanding bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, higher than last month. Keep it neutral, never praise or blame."
    },
    "%lld rupiah bulan ini, sama dengan bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, equal to last month."
    },
    "%lld rupiah bulan ini, turun dibanding bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, lower than last month. Keep it neutral, never praise or blame."
    },
    "+%lld rupiah" : {
      "comment" : "VoiceOver reading of an incoming money amount (income), read as 'plus'. The number is whole rupiah, without separators."
    },
    "Batal" : {
      "comment" : "Cancels: closes the add sheet without saving, or the delete dialog without deleting."
    },
    "Belum ada catatan bulan ini" : {
      "comment" : "Empty state title of the month list."
    },
    "Belum ada pengeluaran" : {
      "comment" : "VoiceOver value for the needs/wants bar when nothing has been spent yet."
    },
    "Belum bisa disimpan" : {
      "comment" : "Alert title when a transaction can't be saved as entered."
    },
    "Belum terhapus" : {
      "comment" : "Alert title when deleting a transaction failed."
    },
    "Belum tersimpan" : {
      "comment" : "Alert title when saving a transaction failed and trying again may work."
    },
    "Catat transaksi" : {
      "comment" : "Logging a new transaction: the add sheet's title and the VoiceOver label of the + button that opens it."
    },
    "Catatan" : {
      "comment" : "Accessibility label of the optional note field in the add sheet."
    },
    "Catatan (opsional)" : {
      "comment" : "Placeholder of the optional note field in the add sheet."
    },
    "Coba hapus sekali lagi ya." : {
      "comment" : "Alert message when deleting a transaction failed: asks to try again."
    },
    "Coba simpan sekali lagi ya." : {
      "comment" : "Alert message when saving a transaction failed: asks to try again."
    },
    "Hapus" : {
      "comment" : "Deletes a transaction: the row's swipe action and the confirm button of the delete dialog."
    },
    "Hapus angka" : {
      "comment" : "VoiceOver label for the keypad key that deletes the last digit."
    },
    "Hapus transaksi ini?" : {
      "comment" : "Title of the dialog confirming that a transaction is deleted."
    },
    "Jenis transaksi" : {
      "comment" : "Accessibility label of the expense/income switch in the add sheet."
    },
    "Kategori ini sudah disembunyikan. Pilih kategori lain ya." : {
      "comment" : "Alert message when the chosen subcategory was hidden, so it can't take new transactions."
    },
    "Kebutuhan" : {
      "comment" : "Name of the needs expense group: the needs/wants bar legend and the add sheet's section header."
    },
    "Kebutuhan %lld persen, Keinginan %lld persen" : {
      "comment" : "VoiceOver value for the needs/wants bar. 1: needs share in percent, 2: wants share in percent; they add up to 100.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kebutuhan %1$lld persen, Keinginan %2$lld persen"
          }
        }
      }

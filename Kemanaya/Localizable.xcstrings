{
  "sourceLanguage" : "id",
  "strings" : {
    "%@ dari %@" : {
      "comment" : "Group budget on Home: spent this month out of the budget, e.g. 'Rp1.344.000 dari Rp3.000.000'.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ dari %2$@"
          }
        }
      }
    },
    "%@ sebesar %@ akan dihapus permanen." : {
      "comment" : "Message of the delete dialog. 1: subcategory name, e.g. Makan. 2: the amount, e.g. Rp30.000.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ sebesar %2$@ akan dihapus permanen."
          }
        }
      }
    },
    "%lld rupiah" : {
      "comment" : "VoiceOver reading of a money amount. The number is whole rupiah, without separators."
    },
    "%lld rupiah bulan ini, naik dibanding bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, higher than last month. Keep it neutral, never praise or blame."
    },
    "%lld rupiah bulan ini, sama dengan bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, equal to last month."
    },
    "%lld rupiah bulan ini, turun dibanding bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, lower than last month. Keep it neutral, never praise or blame."
    },
    "+%lld rupiah" : {
      "comment" : "VoiceOver reading of an incoming money amount (income), read as 'plus'. The number is whole rupiah, without separators."
    },
    "Anggaran %@" : {
      "comment" : "VoiceOver label of a group budget on Home. The placeholder is the group name, Kebutuhan or Keinginan."
    },
    "anggaran %lld rupiah, lewat %lld rupiah" : {
      "comment" : "VoiceOver: a budget and how far spending went over it, in whole rupiah. 1: the budget, 2: the amount over. Neutral, never blame.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "anggaran %1$lld rupiah, lewat %2$lld rupiah"
          }
        }
      }
    },
    "anggaran %lld rupiah, sisa %lld rupiah" : {
      "comment" : "VoiceOver: a budget and what is left of it, in whole rupiah. 1: the budget, 2: the amount left.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "anggaran %1$lld rupiah, sisa %2$lld rupiah"
          }
        }
      }
    },
    "Anggaran bulan ini" : {
      "comment" : "Home: header above the Kebutuhan / Keinginan budget bars."
    },
    "Atur" : {
      "comment" : "Button above Home's pinned cards that opens pin management (pin, unpin, reorder)."
    },
    "Atur kartu" : {
      "comment" : "Title of the pin management sheet, and VoiceOver label of the Atur button that opens it."
    },
    "Batal" : {
      "comment" : "Cancels: closes the add sheet without saving, or the delete dialog without deleting."
    },
    "Belum ada catatan bulan ini" : {
      "comment" : "Empty state title of the month list."
    },
    "Belum ada kartu" : {
      "comment" : "Home, when no subcategory is pinned: title."
    },
    "Belum ada kartu. Nyalakan kategori di bawah untuk menambahkannya ke Beranda." : {
      "comment" : "Pin management: the pinned section when nothing is pinned."
    },
    "Belum ada pemasukan" : {
      "comment" : "Home: shown instead of the savings rate while no income is logged this month."
    },
    "Belum ada pengeluaran" : {
      "comment" : "VoiceOver value for the needs/wants bar when nothing has been spent yet."
    },
    "Belum bisa disimpan" : {
      "comment" : "Alert title when a transaction can't be saved as entered."
    },
    "Belum terhapus" : {
      "comment" : "Alert title when deleting a transaction failed."
    },
    "Belum terlepas" : {
      "comment" : "Alert title when unpinning a card from Home failed."
    },
    "Belum tersimpan" : {
      "comment" : "Alert title when saving a transaction failed and trying again may work."
    },
    "Beranda" : {
      "comment" : "Tab bar: the Home tab, with the month's totals and pinned cards."
    },
    "Bulan ini masih kosong" : {
      "comment" : "Home empty state title: nothing logged this month yet."
    },
    "Catat cepat" : {
      "comment" : "Header above Home's pinned subcategory cards: tapping a card logs into it."
    },

{
  "sourceLanguage" : "id",
  "strings" : {
    "%@ dari %@" : {
      "comment" : "Group budget on Home: spent this month out of the budget, e.g. 'Rp1.344.000 dari Rp3.000.000'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ dari %2$@"
          }
        }
      }
    },
    "%@ sebesar %@ akan dihapus permanen." : {
      "comment" : "Message of the delete dialog. 1: subcategory name, e.g. Makan. 2: the amount, e.g. Rp30.000.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This %2$@ entry in %1$@ will be deleted permanently."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ sebesar %2$@ akan dihapus permanen."
          }
        }
      }
    },
    "%@, sampai hari ini" : {
      "comment" : "VoiceOver value of the year stepper on the current year, e.g. '2026, sampai hari ini' (the year so far).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, year to date"
          }
        }
      }
    },
    "%lld dari %lld huruf" : {
      "comment" : "VoiceOver reading of the name counter in the subcategory editor, e.g. '5 dari 10 huruf'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %2$lld characters"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld dari %2$lld huruf"
          }
        }
      }
    },
    "%lld persen" : {
      "comment" : "VoiceOver: a whole-number share of spending, e.g. '75 persen'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld percent"
          }
        }
      }
    },
    "%lld rupiah" : {
      "comment" : "VoiceOver reading of a money amount. The number is whole rupiah, without separators.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld rupiah"
          }
        }
      }
    },
    "%lld rupiah bulan ini, naik dibanding bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, higher than last month. Keep it neutral, never praise or blame.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld rupiah this month, up from last month"
          }
        }
      }
    },
    "%lld rupiah bulan ini, sama dengan bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, equal to last month.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld rupiah this month, same as last month"
          }
        }
      }
    },
    "%lld rupiah bulan ini, turun dibanding bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, lower than last month. Keep it neutral, never praise or blame.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld rupiah this month, down from last month"
          }
        }
      }
    },
    "%lld rupiah, %@ dari pengeluaran" : {
      "comment" : "VoiceOver value of an Analisis ranked row or donut sector. 1: the subcategory's total in whole rupiah, 2: its share, e.g. '75 persen'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld rupiah, %2$@ of spending"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld rupiah, %2$@ dari pengeluaran"
          }
        }
      }
    },
    "%lld transaksi" : {
      "comment" : "Subcategory detail: the number of transactions this month, e.g. '3 transaksi'.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld transaction"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld transactions"
                }
              }
            }
          }
        }
      }
    },
    "+%lld rupiah" : {
      "comment" : "VoiceOver reading of an incoming money amount (income), read as 'plus'. The number is whole rupiah, without separators.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld rupiah"
          }
        }
      }
    },
    "<1%" : {
      "comment" : "Analisis ranked row: a share of spending under one percent.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<1%"
          }
        }
      }
    },
    "6 bulan terakhir" : {
      "comment" : "Analisis: label above the chart of spending and income for the six months up to the selected month.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last 6 months"
          }
        }
      }
    },
    "Analisis" : {
      "comment" : "Title of the Analisis tab and its tab bar item: spending breakdown and trends.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insights"
          }
        }
      }
    },
    "analysis.row.accessibilityValue.withBudget" : {
      "comment" : "VoiceOver value of an Analisis ranked row with a budget. 1: total and share, 2: the budget and what is left or over. Keep the order.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",

            "value" : "Kebutuhan %1$lld persen, Keinginan %2$lld persen"
          }
        }
      }
    },
    "Kebutuhan dan Keinginan" : {
      "comment" : "VoiceOver label for the bar that splits spending into needs and wants."
    },
    "Keinginan" : {
      "comment" : "Legend name for the wants group on the Kebutuhan vs Keinginan bar."
    },
    "Kemana ya uangku?" : {
      "comment" : "App tagline: 'Where did my money go?'"
    },
    "Tiga nol" : {
      "comment" : "VoiceOver label for the keypad key that adds three zeros (000)."

        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld dari %2$lld dipin"
          }
        }
      }
    },
    "%lld dari %lld huruf" : {
      "comment" : "VoiceOver reading of the name counter in the subcategory editor, e.g. '5 dari 10 huruf'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %2$lld characters"

    },
    "6 bulan terakhir" : {
      "comment" : "Analisis: label above the chart of spending and income for the six months up to the selected month."
    },
    "Analisis" : {
      "comment" : "Title of the Analisis tab and its tab bar item: spending breakdown and trends."
    },
    "analysis.row.accessibilityValue.withBudget" : {

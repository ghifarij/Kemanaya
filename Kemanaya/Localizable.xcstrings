{
  "sourceLanguage" : "id",
  "strings" : {
    "%@ dari total" : {
      "comment" : "A share of the month's or year's total spending, e.g. '73% dari total' ('73% of total'): Analisis's and the yearly recap's ranked rows (D-073). The placeholder is the percent with its sign, e.g. '73%' or '<1%'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of total"
          }
        }
      }
    },
    "%@ sebesar %@ akan dihapus permanen." : {
      "comment" : "Message of the delete dialog. 1: subcategory name, e.g. Makan. 2: the amount, e.g. Rp30.000.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This %2$@ entry in %1$@ will be deleted permanently."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ sebesar %2$@ akan dihapus permanen."
          }
        }
      }
    },
    "%@, sampai hari ini" : {
      "comment" : "VoiceOver value of the year stepper on the current year, e.g. '2026, sampai hari ini' (the year so far).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, year to date"
          }
        }
      }
    },
    "%lld dari %lld dipin" : {
      "comment" : "Pin management: a section header's count, e.g. '3 dari 6 dipin' ('3 of 6 pinned'): cards pinned now out of the section's limit (D-068, D-073).",

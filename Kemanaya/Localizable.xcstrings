    },
    "Anggaran %@" : {
      "comment" : "Kelola subkategori: a row's monthly budget, e.g. 'Anggaran Rp300.000'.\nTitle of the budget sheet for a group, e.g. 'Anggaran Kebutuhan'. The placeholder is the group name.\nTitle of the budget sheet for one subcategory, e.g. 'Anggaran Kopi'. The placeholder is the subcategory name (user data).\nVoiceOver label of a group budget on Home. The placeholder is the group name, Kebutuhan or Keinginan."
    },
    "Anggaran %@ per bulan" : {
      "comment" : "Subcategory detail: the subcategory's standing monthly budget, e.g. 'Anggaran Rp300.000 per bulan'."
    },
    "anggaran %lld rupiah, lewat %lld rupiah" : {

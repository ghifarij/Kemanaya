    },
    "%lld rupiah bulan ini, turun dibanding bulan lalu" : {
      "comment" : "VoiceOver value of a subcategory card: this month's total in whole rupiah, lower than last month. Keep it neutral, never praise or blame."
    },
    "%lld rupiah, %@ dari pengeluaran" : {
      "comment" : "VoiceOver value of an Analisis ranked row or donut sector. 1: the subcategory's total in whole rupiah, 2: its share, e.g. '75 persen'.",
